# Rust
/target/
**/*.rs.bk

# Node
node_modules/
.pnpm-store/

# Build output
apps/shell/dist/
apps/shell/src-tauri/gen/

# ts-rs's default output. The bindings the frontend uses are generated into
# packages/core/src/generated by `pnpm gen:types`; a plain `cargo test` drops a
# second, unused copy here.
crates/*/bindings/

# Test and tooling output
screenshots/
playwright-report/
test-results/
*.staged.ttf

# Editor and OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python bytecode from the icon generator.
__pycache__/
