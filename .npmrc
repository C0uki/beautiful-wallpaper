# Run package scripts through pnpm's own POSIX shell rather than through
# `cmd.exe`, which is what pnpm reaches for on Windows. `gen:types` sets an
# environment variable for one command and expands `$PWD`; cmd.exe understands
# neither, so on Windows — the platform this shell targets — the script that
# regenerates the TypeScript contract could not be run at all.
shell-emulator=true
