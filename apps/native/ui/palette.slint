// The colours the native surfaces share.

export global Palette {
    // The webview bar's `hug` style in the dark appearance, which is Apple's
    // fixed greys rather than anything taken from the wallpaper.
    out property <color> background: #282828;
    out property <color> foreground: #e0e0e0;
    out property <color> quiet: #e0e0e0a0;
    out property <color> hover: #ffffff1a;
    out property <color> accent: #0a84ff;
    out property <color> filled: #ffffff26;
    out property <color> outline: #ffffff33;
    // The readout's block and its track.
    out property <color> popover: #2a2a2c;
    out property <color> track: #48484a;
    out property <color> muted: #8e8e93;
    // A critical notification's tile.
    out property <color> danger: #ff453a;
}
