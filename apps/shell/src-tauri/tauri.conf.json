{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beautiful-wallpaper",
  "mainBinaryName": "bw",
  "version": "0.3.2",
  "identifier": "io.github.c0uki.beautiful-wallpaper",
  "build": {
    "beforeDevCommand": "pnpm --filter @bw/shell dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @bw/shell build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/**", "$APPLOCALDATA/**", "$HOME/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMkY0NEI5NDI1N0NGRDgKUldUWXoxZEN1VVF2dmt4R3VMOTJVUlloYVJWRGtwQ3dTNEc5eWlEamxVOG1RNXg1SmlaMmdCSmwK",
      "endpoints": [
        "https://github.com/C0uki/beautiful-wallpaper/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A Material 3 desktop shell for Windows",
    "longDescription": "Wallpaper-driven Material 3 theming, desktop widgets and a wallpaper browser for Windows 10 and 11.",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer.nsh",
        "languages": ["English", "Japanese"]
      },
      "wix": {
        "language": ["en-US", "ja-JP"]
      }
    }
  }
}
