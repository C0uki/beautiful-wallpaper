{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the shell's surfaces are allowed to do. Kept to the minimum each one needs: read the wallpaper folder, show and hide sibling surfaces, and open a link in the browser.",
  "windows": [
    "background",
    "wallpaperSelector",
    "bar",
    "settings",
    "osd",
    "notifications",
    "sidebarRight",
    "sidebarLeft",
    "dock",
    "overview",
    "regionSelect",
    "session",
    "desktopMenu",
    "shelf"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:webview:allow-webview-position",
    "opener:allow-open-url",
    "global-shortcut:default",
    "dialog:allow-open"
  ]
}
