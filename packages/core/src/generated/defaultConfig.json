{
  "ai": {
    "model": "claude-opus-5",
    "maxTokens": 4096,
    "webSearch": true,
    "maxSearches": 5,
    "showThinking": true
  },
  "appearance": {
    "palette": {
      "type": "auto",
      "accentColor": null,
      "mode": "dark"
    },
    "fonts": {
      "main": "Segoe UI Variable Text, Segoe UI, sans-serif",
      "title": "Segoe UI Variable Display, Segoe UI, sans-serif",
      "monospace": "Cascadia Code, Consolas, monospace",
      "reading": "Georgia, serif",
      "expressive": "Segoe UI Variable Display, Segoe UI, sans-serif",
      "pixelSize": 15.0
    },
    "transparency": {
      "enable": true,
      "extra": 0.0
    },
    "wallpaperTheming": {
      "syncSystemAccent": true,
      "syncWindowsTerminal": false
    },
    "roundingScale": 1.0
  },
  "audio": {
    "step": 5,
    "protection": {
      "enable": true,
      "maxVolume": 100
    }
  },
  "background": {
    "wallpaperPath": "",
    "thumbnailPath": "",
    "wallpaperAnimation": "circle",
    "transitionDuration": 1200,
    "centeredWallpaper": false,
    "centeredWallpaperShape": "clover",
    "centeredWallpaperSize": 0.55,
    "parallax": {
      "enable": true,
      "zoom": 1.07,
      "workspacePan": 0.6
    },
    "widgets": {
      "enable": true,
      "grid": 8,
      "clock": {
        "id": "clock",
        "enable": true,
        "x": 0.04,
        "y": 0.06,
        "placementStrategy": "free",
        "style": "default"
      },
      "media": {
        "id": "media",
        "enable": true,
        "x": 0.04,
        "y": 0.3,
        "placementStrategy": "free",
        "style": "default"
      },
      "weather": {
        "id": "weather",
        "enable": true,
        "x": 0.72,
        "y": 0.05,
        "placementStrategy": "free",
        "style": "default"
      },
      "resources": {
        "id": "resources",
        "enable": true,
        "x": 0.72,
        "y": 0.2,
        "placementStrategy": "free",
        "style": "default"
      },
      "calendar": {
        "id": "calendar",
        "enable": false,
        "x": 0.72,
        "y": 0.45,
        "placementStrategy": "free",
        "style": "default"
      },
      "userCard": {
        "id": "userCard",
        "enable": false,
        "x": 0.72,
        "y": 0.6,
        "placementStrategy": "free",
        "style": "default"
      },
      "notes": {
        "id": "notes",
        "enable": false,
        "x": 0.04,
        "y": 0.62,
        "placementStrategy": "free",
        "style": "default"
      }
    }
  },
  "bar": {
    "enable": true,
    "bottom": false,
    "vertical": false,
    "height": 40,
    "reserveSpace": true,
    "autoHide": false,
    "style": "m3",
    "left": ["media"],
    "center": ["workspaces", "activeWindow"],
    "right": ["tray", "resources", "network", "battery", "utilButtons", "clock"]
  },
  "dock": {
    "enable": false,
    "height": 60,
    "iconSize": 44,
    "pinnedApps": [],
    "ignored": [],
    "showBackground": true,
    "showPinButton": true,
    "showMedia": true,
    "autoHide": true,
    "hoverRegionHeight": 3,
    "pinnedOnStartup": false
  },
  "hacks": {
    "configReloadDelay": 50
  },
  "keybinds": {
    "enable": true,
    "overview": "Alt+Space",
    "sidebarLeft": "Super+Shift+A",
    "sidebarRight": "Super+Shift+N",
    "wallpaperSelector": "Super+Shift+W",
    "widgetEditMode": "Super+Shift+D"
  },
  "language": {
    "ui": "auto"
  },
  "notifications": {
    "enable": true,
    "timeout": 7000,
    "position": "top_right",
    "maxVisible": 4,
    "doNotDisturb": false,
    "width": 380
  },
  "osd": {
    "enable": true,
    "timeout": 1000,
    "position": "top",
    "volume": true,
    "brightness": true
  },
  "overview": {
    "enable": true,
    "maxResults": 8,
    "searchEngine": "https://www.google.com/search?q=%s",
    "showWindows": true,
    "showApps": true,
    "allowRunCommand": true
  },
  "policies": {
    "ai": 1,
    "weeb": 0
  },
  "resources": {
    "pollInterval": 2000,
    "showSwap": false
  },
  "sidebar": {
    "enable": true,
    "width": 0.26,
    "banner": true,
    "bannerImage": "",
    "mediaPlayer": true,
    "notificationCentre": true,
    "profile": {
      "displayName": "",
      "avatarPath": ""
    },
    "quickToggles": {
      "enable": true,
      "style": "android"
    },
    "quickSliders": {
      "enable": true,
      "showBrightness": true,
      "showVolume": true,
      "showMic": true
    },
    "nightLight": {
      "enable": false,
      "temperature": 4000,
      "automatic": false,
      "from": "20:00",
      "to": "07:00"
    },
    "left": {
      "enable": true,
      "width": 0.26,
      "translator": {
        "enable": true,
        "delay": 300,
        "from": "auto",
        "to": "en"
      },
      "media": {
        "enable": true
      },
      "booru": {
        "provider": "safebooru",
        "allowAdult": false,
        "perPage": 30
      }
    }
  },
  "time": {
    "format": "HH:mm",
    "dateFormat": "ddd, dd/MM",
    "weekStartsOnMonday": true
  },
  "wallpaperSelector": {
    "userPath": "",
    "columns": 4,
    "showSearchbar": true,
    "closeAfterSelection": true,
    "changeInterval": 0,
    "extensions": ["jpg", "jpeg", "png", "webp", "bmp", "gif"],
    "online": {
      "enable": true,
      "defaultProvider": "wallhaven",
      "resolution": "1080p",
      "purity": "sfw",
      "category": "general",
      "downloadPath": ""
    }
  },
  "weather": {
    "enable": true,
    "city": "",
    "useUscUnits": false,
    "refreshInterval": 900
  },
  "windows": {
    "windowManager": "auto",
    "glazewm": {
      "port": 6123
    },
    "komorebi": {
      "pipeName": "komorebi"
    },
    "hideSystemTaskbar": false,
    "startWithWindows": false,
    "backdrop": "auto"
  },
  "workSafety": {
    "blankWallpaper": false,
    "keywords": []
  }
}
