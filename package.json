{
  "name": "beautiful-wallpaper",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @bw/shell dev",
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint apps packages",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "test": "pnpm -r test",
    "screenshots": "pnpm --filter @bw/shell screenshots",
    "gen:types": "TS_RS_EXPORT_DIR=$PWD/packages/core/src/generated cargo test -p bw-core --quiet && cargo run -q -p bw-core --example emit_defaults -- packages/core/src/generated/defaultConfig.json && pnpm exec prettier --write --log-level warn packages/core/src/generated",
    "gen:icons": "python3 apps/shell/scripts/gen_icons.py"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.42.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
